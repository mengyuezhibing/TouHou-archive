  "lines": [
    {
      "index": 1,
      "time": 0,
      "text": "久々のお仕事だわ。",
      "encoding": "shift_jis"
    },
    {
      "index": 2,
      "time": 0,
      "text": "気持ちいいわね",
      "encoding": "shift_jis"
    },
    {
      "index": 3,
      "time": 0,
      "text": "毎回、昼間に出発して悪霊が少ない",
      "encoding": "shift_jis"
    },
    {
      "index": 4,
      "time": 0,
      "text": "から、夜に出てみたんだけど...",
      "encoding": "shift_jis"
    },
    {
      "index": 5,
      "time": 0,
      "text": "どこに行っていいかわからないわ",
      "encoding": "shift_jis"
    },
    {
      "index": 6,
      "time": 0,
      "text": "暗くて",
      "encoding": "shift_jis"
    },
    {
      "index": 7,
      "time": 0,
      "text": "でも...",
      "encoding": "shift_jis"
    },
    {
      "index": 8,
      "time": 0,
      "text": "夜の境内裏はロマンティックね",
      "encoding": "shift_jis"
    },
