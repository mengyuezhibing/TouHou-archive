      "index": 9,
      "time": 0,
      "text": "（←のんき）",
      "encoding": "shift_jis"
    },
    {
      "index": 10,
      "time": 0,
      "text": "そうなのよね～",
      "encoding": "shift_jis"
    },
    {
      "index": 11,
      "time": 0,
      "text": "お化けも出るし、たまんないわ",
      "encoding": "shift_jis"
    },
    {
      "index": 12,
      "time": 0,
      "text": "って、",
      "encoding": "shift_jis"
    },
    {
      "index": 13,
      "time": 0,
      "text": "あんた誰？",
      "encoding": "shift_jis"
    },
    {
      "index": 14,
      "time": 0,
      "text": "宵闇の妖怪",
      "encoding": "shift_jis"
    },
    {
      "index": 15,
      "time": 0,
      "text": "ルーミア",
      "encoding": "shift_jis"
    },
    {
      "index": 16,
      "time": 0,
      "text": "さっき会ったじゃない",
      "encoding": "shift_jis"
    },
    {
      "index": 17,
      "time": 0,
      "text": "あんた、もしかして鳥目？",
      "encoding": "shift_jis"
    },
    {
      "index": 18,
      "time": 0,
      "text": "人は暗いところでは物が",
      "encoding": "shift_jis"
    },
    {
      "index": 19,
      "time": 0,
      "text": "良く見えないのよ",
      "encoding": "shift_jis"
    },
    {
      "index": 20,
      "time": 0,
      "text": "あら？夜しか活動しない人も",
      "encoding": "shift_jis"
    },
    {
      "index": 21,
      "time": 0,
      "text": "見たことある気がするわ",
      "encoding": "shift_jis"
    },
    {
      "index": 22,
      "time": 0,
      "text": "それは取って食べたりしても",
      "encoding": "shift_jis"
    },
    {
      "index": 23,
      "time": 0,
      "text": "いいのよ",
      "encoding": "shift_jis"
    },
    {
      "index": 24,
      "time": 0,
      "text": "そーなのかー",
      "encoding": "shift_jis"
    },
    {
      "index": 25,
      "time": 0,
      "text": "で、邪魔なんですけど",
      "encoding": "shift_jis"
    },
    {
      "index": 26,
      "time": 0,
      "text": "目の前が取って食べれる人類？",
      "encoding": "shift_jis"
    },
    {
      "index": 27,
      "time": 0,
      "text": "良薬は口に苦し",
      "encoding": "shift_jis"
    },
    {
      "index": 28,
      "time": 0,
      "text": "って言葉知ってる？",
      "encoding": "shift_jis"
    },
    {
      "index": 29,
      "time": 0,
      "text": "良薬っていっても",
      "encoding": "shift_jis"
    },
    {
      "index": 30,
      "time": 0,
      "text": "飲んでみなけりゃわかんないけどね",
      "encoding": "shift_jis"
    },
    {
      "index": 31,
      "time": 0,
      "text": "こういう気持ち、なんというか･･･",
      "encoding": "shift_jis"
    },
    {
      "index": 32,
      "time": 0,
      "text": "あいつだったら「気持ちいいわね」",
      "encoding": "shift_jis"
    },
    {
      "index": 33,
      "time": 0,
      "text": "とかいいそうだな",
      "encoding": "shift_jis"
    },
    {
      "index": 34,
      "time": 0,
      "text": "わたしは夜は嫌いだけどな",
      "encoding": "shift_jis"
    },
    {
      "index": 35,
      "time": 0,
      "text": "変な奴しかいないし",
      "encoding": "shift_jis"
    },
    {
      "index": 36,
      "time": 0,
      "text": "変な奴って誰のことよ",
      "encoding": "shift_jis"
    },
    {
      "index": 37,
      "time": 0,
      "text": "誰もあんたのことって言ってないぜ",
      "encoding": "shift_jis"
    },
    {
      "index": 38,
      "time": 0,
      "text": "宵闇の妖怪",
      "encoding": "shift_jis"
    },
    {
      "index": 39,
      "time": 0,
      "text": "ルーミア",
      "encoding": "shift_jis"
    },
    {
      "index": 40,
      "time": 0,
      "text": "それはまぁ、当然",
      "encoding": "shift_jis"
    },
    {
      "index": 41,
      "time": 0,
      "text": "で、何でそんな手広げてるのさ",
      "encoding": "shift_jis"
    },
    {
      "index": 42,
      "time": 0,
      "text": "「聖者は十字架に磔られました」",
      "encoding": "shift_jis"
    },
    {
      "index": 43,
      "time": 0,
      "text": "っていってるように見える？",
      "encoding": "shift_jis"
    },
    {
      "index": 44,
      "time": 0,
      "text": "「人類は十進法を採用しました」",
      "encoding": "shift_jis"
    },
    {
      "index": 45,
      "time": 0,
      "text": "って見えるな",
      "encoding": "shift_jis"
    },
    {
      "index": 46,
      "time": 0,
      "text": "人類以外は",
      "encoding": "shift_jis"
    },
    {
