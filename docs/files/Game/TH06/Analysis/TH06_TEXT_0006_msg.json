{
  "layout": "scanned",
  "lines": [
    {
      "index": 1,
      "time": 0,
      "text": "そろそろ姿、見せてもいいん",
      "encoding": "shift_jis"
    },
    {
      "index": 2,
      "time": 0,
      "text": "じゃない？",
      "encoding": "shift_jis"
    },
    {
      "index": 3,
      "time": 0,
      "text": "お嬢さん？",
      "encoding": "shift_jis"
    },
    {
      "index": 4,
      "time": 0,
      "text": "やっぱり、人間って使えないわね",
      "encoding": "shift_jis"
    },
    {
      "index": 5,
      "time": 0,
      "text": "永遠の紅い幼き月",
      "encoding": "shift_jis"
    },
    {
      "index": 6,
      "time": 0,
      "text": "レミリア・スカーレット",
      "encoding": "shift_jis"
    },
    {
      "index": 7,
      "time": 0,
      "text": "さっきのメイドは人間だったのか",
      "encoding": "shift_jis"
    },
    {
      "index": 8,
      "time": 0,
      "text": "あなた、殺人犯ね",
      "encoding": "shift_jis"
    },
    {
      "index": 9,
      "time": 0,
      "text": "一人までなら大量殺人犯じゃない",
      "encoding": "shift_jis"
    },
    {
      "index": 10,
      "time": 0,
      "text": "から大丈夫よ",
      "encoding": "shift_jis"
    },
    {
      "index": 12,
      "time": 0,
      "text": "そうそう、迷惑なの",
      "encoding": "shift_jis"
    },
    {
      "index": 13,
      "time": 0,
      "text": "あんたが",
      "encoding": "shift_jis"
    },
    {
      "index": 14,
      "time": 0,
      "text": "短絡ね。しかも理由が分からない",
      "encoding": "shift_jis"
    },
    {
      "index": 15,
      "time": 0,
      "text": "とにかく、ここから出ていって",
      "encoding": "shift_jis"
    },
    {
      "index": 16,
      "time": 0,
      "text": "くれる？",
      "encoding": "shift_jis"
    },
    {
      "index": 17,
      "time": 0,
      "text": "ここは、私の城よ？",
      "encoding": "shift_jis"
    },
    {
      "index": 18,
      "time": 0,
      "text": "出ていくのはあなただわ。",
      "encoding": "shift_jis"
    },
    {
      "index": 19,
      "time": 0,
      "text": "この世から出てってほしいのよ",
      "encoding": "shift_jis"
    },
    {
      "index": 20,
      "time": 0,
      "text": "しょうがないわね",
      "encoding": "shift_jis"
    },
    {
      "index": 21,
      "time": 0,
      "text": "今、お腹いっぱいだけど・・・",
      "encoding": "shift_jis"
    },
    {
      "index": 22,
      "time": 0,
      "text": "護衛にあのメイドを",
      "encoding": "shift_jis"
    },
    {
      "index": 23,
      "time": 0,
      "text": "雇っていたんでしょ？",
      "encoding": "shift_jis"
    },
    {
      "index": 24,
      "time": 0,
      "text": "そんな、箱入りお嬢様なんて",
      "encoding": "shift_jis"
    },
    {
      "index": 25,
      "time": 0,
      "text": "一撃よ！",
      "encoding": "shift_jis"
    },
    {
      "index": 26,
      "time": 0,
      "text": "咲夜は優秀な掃除係",
      "encoding": "shift_jis"
    },
    {
      "index": 27,
      "time": 0,
      "text": "おかげで、首一つ落ちてないわ",
      "encoding": "shift_jis"
    },
    {
      "index": 28,
      "time": 0,
      "text": "あなたはつよいの？",
      "encoding": "shift_jis"
    },
    {
      "index": 29,
      "time": 0,
      "text": "さあね。",
      "encoding": "shift_jis"
    },
    {
      "index": 30,
      "time": 0,
      "text": "あんまり外に出して貰えないの",
      "encoding": "shift_jis"
    },
    {
      "index": 31,
      "time": 0,
      "text": "私が日光に弱いから",
      "encoding": "shift_jis"
    },
    {
      "index": 32,
      "time": 0,
      "text": "・・・",
      "encoding": "shift_jis"
    },
    {
      "index": 33,
      "time": 0,
      "text": "なかなか出来るわね",
      "encoding": "shift_jis"
    },
    {
      "index": 34,
      "time": 0,
      "text": "こんなに月も紅いから",
      "encoding": "shift_jis"
    },
    {
      "index": 35,
      "time": 0,
      "text": "本気で殺すわよ",
      "encoding": "shift_jis"
    },
    {
      "index": 36,
      "time": 0,
      "text": "こんなに月も紅いのに",
      "encoding": "shift_jis"
    },
    {
      "index": 37,
      "time": 0,
      "text": "楽しい夜になりそうね",
      "encoding": "shift_jis"
    },
    {
      "index": 38,
      "time": 0,
      "text": "永い夜になりそうね",
      "encoding": "shift_jis"
    },
    {
      "index": 39,
      "time": 0,
      "text": "お嬢様の怒られる前に",
      "encoding": "shift_jis"
    },
    {
      "index": 40,
      "time": 0,
      "text": "せめて１ボムでも潰させないと～",
      "encoding": "shift_jis"
    },
    {
      "index": 41,
      "time": 0,
      "text": "黙って、お使いにでも出たら？",
      "encoding": "shift_jis"
    },
    {
      "index": 42,
      "time": 0,
      "text": "いるいる",
      "encoding": "shift_jis"
    },
    {
      "index": 43,
      "time": 0,
      "text": "悪寒が走るわ、この妖気",
      "encoding": "shift_jis"
    },
    {
      "index": 44,
      "time": 0,
      "text": "何で強力な奴ほど隠れるんだ？",
      "encoding": "shift_jis"
    },
    {
      "index": 45,
      "time": 0,
      "text": "能ある鷹は尻尾隠さず...",
      "encoding": "shift_jis"
    },
    {
      "index": 47,
      "time": 0,
      "text": "永遠の紅い幼き月",
      "encoding": "shift_jis"
    },
    {
      "index": 48,
      "time": 0,
      "text": "レミリア・スカーレット",
      "encoding": "shift_jis"
    },
    {
      "index": 49,
      "time": 0,
      "text": "...脳なさそうだな",
      "encoding": "shift_jis"
    },
    {
      "index": 50,
      "time": 0,
      "text": "人間だけよ",
      "encoding": "shift_jis"
    },
    {
      "index": 51,
      "time": 0,
      "text": "脳なんて単純で化学的な",
      "encoding": "shift_jis"
    },
    {
      "index": 52,
      "time": 0,
      "text": "思考中枢が必要なのは",
      "encoding": "shift_jis"
    },
    {
      "index": 53,
      "time": 0,
      "text": "おまえ、アレだろ？",
      "encoding": "shift_jis"
    },
    {
      "index": 54,
      "time": 0,
      "text": "ほら日光とか臭い野菜とか",
      "encoding": "shift_jis"
    },
    {
      "index": 55,
      "time": 0,
      "text": "銀のアレとか",
      "encoding": "shift_jis"
    },
    {
      "index": 56,
      "time": 0,
      "text": "夜の支配者なのに",
      "encoding": "shift_jis"
    },
    {
      "index": 57,
      "time": 0,
      "text": "なぜか弱点の多いという...",
      "encoding": "shift_jis"
    },
    {
      "index": 58,
      "time": 0,
      "text": "そうよ、病弱っ娘なのよ",
      "encoding": "shift_jis"
    },
    {
      "index": 59,
      "time": 0,
      "text": "面白そうだな、やっぱ飲むのか？",
      "encoding": "shift_jis"
    },
    {
      "index": 60,
      "time": 0,
      "text": "アレ",
      "encoding": "shift_jis"
    },
    {
      "index": 61,
      "time": 0,
      "text": "当たり前じゃない",
      "encoding": "shift_jis"
    },
    {
      "index": 62,
      "time": 0,
      "text": "私は小食でいつも残すけどね",
      "encoding": "shift_jis"
    },
    {
      "index": 63,
      "time": 0,
      "text": "今まで何人の血を吸ってきた？",
      "encoding": "shift_jis"
    },
    {
      "index": 64,
      "time": 0,
      "text": "あなたは今まで食べてきたパンの",
      "encoding": "shift_jis"
    },
    {
      "index": 65,
      "time": 0,
      "text": "枚数を覚えてるの？",
      "encoding": "shift_jis"
    },
    {
      "index": 67,
      "time": 0,
      "text": "私は和食ですわ",
      "encoding": "shift_jis"
    },
    {
      "index": 68,
      "time": 0,
      "text": "で、何しに来たの？",
      "encoding": "shift_jis"
    },
    {
      "index": 69,
      "time": 0,
      "text": "もう、私お腹いっぱいだけど・・",
      "encoding": "shift_jis"
    },
    {
      "index": 70,
      "time": 0,
      "text": "そうだな、私はお腹がすいたぜ",
      "encoding": "shift_jis"
    },
    {
      "index": 71,
      "time": 0,
      "text": "・・・食べても、いいのよ",
      "encoding": "shift_jis"
    },
    {
      "index": 72,
      "time": 0,
      "text": "ああ、そうかい",
      "encoding": "shift_jis"
    },
    {
      "index": 73,
      "time": 0,
      "text": "今の、植物の名前だぜ",
      "encoding": "shift_jis"
    },
    {
      "index": 74,
      "time": 0,
      "text": "「亜阿相界」",
      "encoding": "shift_jis"
    },
    {
      "index": 75,
      "time": 0,
      "text": "人間って楽しいわね",
      "encoding": "shift_jis"
    },
    {
      "index": 76,
      "time": 0,
      "text": "それともあなたは人間じゃ",
      "encoding": "shift_jis"
    },
    {
      "index": 77,
      "time": 0,
      "text": "ないのかしら？",
      "encoding": "shift_jis"
    },
    {
      "index": 78,
      "time": 0,
      "text": "楽しい人間だぜ",
      "encoding": "shift_jis"
    },
    {
      "index": 79,
      "time": 0,
      "text": "ふふふ、こんなに月も紅いから？",
      "encoding": "shift_jis"
    },
    {
      "index": 80,
      "time": 0,
      "text": "暑い夜になりそうね",
      "encoding": "shift_jis"
    },
    {
      "index": 81,
      "time": 0,
      "text": "涼しい夜になりそうだな",
      "encoding": "shift_jis"
    },
    {
      "index": 82,
      "time": 0,
      "text": "あなたみたいな人も珍しいわね",
      "encoding": "shift_jis"
    },
    {
      "index": 83,
      "time": 0,
      "text": "こっちには何もないわよ？",
      "encoding": "shift_jis"
    },
    {
      "index": 84,
      "time": 0,
      "text": "おまえもな",
      "encoding": "shift_jis"
    },
    {
      "index": 85,
      "time": 0,
      "text": "ほんとにメイドなのか？",
      "encoding": "shift_jis"
    }
