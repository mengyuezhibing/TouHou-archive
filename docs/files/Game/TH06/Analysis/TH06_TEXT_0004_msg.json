  "lines": [
    {
      "index": 0,
      "time": 0,
      "text": "この家には窓が無いのかしら？",
      "encoding": "shift_jis"
    },
    {
      "index": 1,
      "time": 0,
      "text": "それに外から見たとき",
      "encoding": "shift_jis"
    },
    {
      "index": 2,
      "time": 0,
      "text": "こんなに広かったっけ？",
      "encoding": "shift_jis"
    },
    {
      "index": 3,
      "time": 0,
      "text": "そこの紅白！",
      "encoding": "shift_jis"
    },
    {
      "index": 4,
      "time": 0,
      "text": "私の書斎で暴れない",
      "encoding": "shift_jis"
    },
    {
      "index": 5,
      "time": 0,
      "text": "書斎？（紅白？）",
      "encoding": "shift_jis"
    },
    {
      "index": 6,
      "time": 0,
      "text": "これらの本はあなたの神社の",
      "encoding": "shift_jis"
    },
    {
      "index": 7,
      "time": 0,
      "text": "５年分の賽銭程度の価値があるわ",
      "encoding": "shift_jis"
    },
    {
      "index": 8,
      "time": 0,
      "text": "知識と日陰の少女",
      "encoding": "shift_jis"
    },
    {
      "index": 9,
      "time": 0,
      "text": "パチュリー・ノーレッジ",
      "encoding": "shift_jis"
    },
    {
      "index": 10,
      "time": 0,
      "text": "うちは年中無休で参拝客が無いわよ",
      "encoding": "shift_jis"
    },
    {
      "index": 11,
      "time": 0,
      "text": "まぁその程度の価値しか無いんだよ",
      "encoding": "shift_jis"
    },
    {
      "index": 12,
      "time": 0,
      "text": "それにしてもこんな暗い部屋で",
      "encoding": "shift_jis"
    },
    {
      "index": 13,
      "time": 0,
      "text": "本なんか読めるのか？",
      "encoding": "shift_jis"
    },
    {
      "index": 14,
      "time": 0,
      "text": "私はあなたみたいに鳥目",
      "encoding": "shift_jis"
    },
    {
      "index": 15,
      "time": 0,
      "text": "じゃないわ",
      "encoding": "shift_jis"
    },
    {
      "index": 16,
      "time": 0,
      "text": "だから～、私は鳥目じゃない",
      "encoding": "shift_jis"
    },
    {
      "index": 17,
      "time": 0,
      "text": "って",
      "encoding": "shift_jis"
    },
    {
      "index": 18,
      "time": 0,
      "text": "って、そうじゃなくて、",
      "encoding": "shift_jis"
    },
    {
      "index": 19,
      "time": 0,
      "text": "あなたが、ここのご主人？",
      "encoding": "shift_jis"
    },
    {
      "index": 20,
      "time": 0,
      "text": "お嬢様になんの用？",
      "encoding": "shift_jis"
    },
    {
      "index": 21,
      "time": 0,
      "text": "霧の出しすぎで、困る",
      "encoding": "shift_jis"
    },
    {
      "index": 22,
      "time": 0,
      "text": "じゃぁ、お嬢様には絶対会わせ",
      "encoding": "shift_jis"
    },
    {
      "index": 23,
      "time": 0,
      "text": "ないわ",
      "encoding": "shift_jis"
    },
    {
      "index": 24,
      "time": 0,
      "text": "邪魔させないわ",
      "encoding": "shift_jis"
    },
    {
      "index": 25,
      "time": 0,
      "text": "・・・ところで、あんた、誰？",
      "encoding": "shift_jis"
    },
    {
      "index": 26,
      "time": 0,
      "text": "それにしてもこの館って、外から",
      "encoding": "shift_jis"
    },
    {
      "index": 27,
      "time": 0,
      "text": "見て、こんなに広かったっけ？",
      "encoding": "shift_jis"
    },
    {
      "index": 28,
      "time": 0,
      "text": "家には空間をいじるのが好きな人が",
      "encoding": "shift_jis"
    },
    {
      "index": 29,
      "time": 0,
      "text": "いるのよ",
      "encoding": "shift_jis"
    },
    {
      "index": 30,
      "time": 0,
      "text": "わぁ、本がいっぱいだぁ",
      "encoding": "shift_jis"
    },
    {
      "index": 31,
      "time": 0,
      "text": "後で、さっくり貰っていこ",
      "encoding": "shift_jis"
    },
    {
      "index": 32,
      "time": 0,
      "text": "持ってかないでー",
      "encoding": "shift_jis"
    },
    {
      "index": 33,
      "time": 0,
      "text": "持ってくぜ",
      "encoding": "shift_jis"
    },
    {
      "index": 34,
      "time": 0,
      "text": "えぇーと、目の前の黒いのを",
      "encoding": "shift_jis"
    },
    {
      "index": 35,
      "time": 0,
      "text": "消極的にやっつけるには・・・",
      "encoding": "shift_jis"
    },
    {
      "index": 36,
      "time": 0,
      "text": "知識と日陰の少女",
      "encoding": "shift_jis"
    },
    {
      "index": 37,
      "time": 0,
      "text": "パチュリー・ノーレッジ",
      "encoding": "shift_jis"
    },
    {
      "index": 38,
      "time": 0,
      "text": "（載ってるのか？）",
      "encoding": "shift_jis"
    },
    {
      "index": 39,
      "time": 0,
      "text": "うーん、最近、目が悪くなったわ",
      "encoding": "shift_jis"
    },
    {
      "index": 40,
      "time": 0,
      "text": "部屋が暗いんじゃないのか？",
      "encoding": "shift_jis"
    },
    {
      "index": 41,
      "time": 0,
      "text": "鉄分が足りないのかしら",
      "encoding": "shift_jis"
    },
    {
      "index": 42,
      "time": 0,
      "text": "どっちかっつーとビタミンＡだな",
      "encoding": "shift_jis"
    },
    {
      "index": 43,
      "time": 0,
      "text": "あなたは？",
      "encoding": "shift_jis"
    },
    {
      "index": 44,
      "time": 0,
      "text": "足りてるぜ、色々とな",
      "encoding": "shift_jis"
    },
    {
      "index": 45,
      "time": 0,
      "text": "じゃぁ、頂こうかしら",
      "encoding": "shift_jis"
    },
    {
      "index": 46,
      "time": 0,
      "text": "私は美味しいぜ",
      "encoding": "shift_jis"
    },
    {
      "index": 47,
      "time": 0,
      "text": "えぇーと、簡単に素材のアクを",
      "encoding": "shift_jis"
    },
    {
      "index": 48,
      "time": 0,
      "text": "取り除く調理法は・・・",
      "encoding": "shift_jis"
    },
    {
      "index": 49,
      "time": 0,
      "text": "魔法が得意のようだな",
      "encoding": "shift_jis"
    },
    {
      "index": 50,
      "time": 0,
      "text": "まだ、隠しもってんじゃないのか？",
      "encoding": "shift_jis"
    },
    {
      "index": 51,
      "time": 0,
      "text": "しくしく、貧血でスペルが",
      "encoding": "shift_jis"
    },
    {
      "index": 52,
      "time": 0,
      "text": "唱え切れないの",
      "encoding": "shift_jis"
