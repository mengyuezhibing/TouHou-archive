    },
    {
      "index": 11,
      "time": 0,
      "text": "えー、普通の人よ",
      "encoding": "shift_jis"
    },
    {
      "index": 12,
      "time": 0,
      "text": "さっき攻撃仕掛けてきたでしょ？",
