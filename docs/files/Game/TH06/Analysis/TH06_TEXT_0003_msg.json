    },
    {
      "index": 21,
      "time": 0,
      "text": "言い伝えるな！",
      "encoding": "shift_jis"
    },
    {
      "index": 22,
      "time": 0,
      "text": "さぁて、道案内してもらいますよ",
      "encoding": "shift_jis"
    },
    {
      "index": 23,
      "time": 0,
      "text": "済みません、お嬢様～",
      "encoding": "shift_jis"
    },
    {
      "index": 24,
      "time": 0,
      "text": "くそ、背水の陣だ！",
      "encoding": "shift_jis"
    },
    {
      "index": 25,
      "time": 0,
      "text": "あんた一人で「陣」なのか？",
      "encoding": "shift_jis"
    },
    {
      "index": 26,
      "time": 0,
      "text": "あ、さっきはどうも",
      "encoding": "shift_jis"
    },
    {
      "index": 27,
      "time": 0,
      "text": "お久しぶりですわ",
      "encoding": "shift_jis"
    },
    {
      "index": 28,
      "time": 0,
      "text": "って、私たちいつから知り合いに",
      "encoding": "shift_jis"
    },
    {
      "index": 29,
      "time": 0,
      "text": "なったのよ～",
      "encoding": "shift_jis"
    },
