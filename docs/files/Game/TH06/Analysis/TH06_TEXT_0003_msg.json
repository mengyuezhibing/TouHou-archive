    },
    {
      "index": 37,
      "time": 0,
      "text": "番人だから、邪魔するのよ",
      "encoding": "shift_jis"
    },
    {
      "index": 38,
      "time": 0,
      "text": "やっぱ、あんた、番人なのか？",
      "encoding": "shift_jis"
    },
    {
      "index": 39,
      "time": 0,
      "text": "番人してるだけの普通の人よ",
