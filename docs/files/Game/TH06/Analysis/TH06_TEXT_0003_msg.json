    },
    {
      "index": 17,
      "time": 0,
      "text": "それはよかった",
      "encoding": "shift_jis"
    },
    {
      "index": 18,
      "time": 0,
      "text": "たしか．．．",
      "encoding": "shift_jis"
    },
    {
      "index": 19,
      "time": 0,
      "text": "巫女は食べてもいい人類だって",
      "encoding": "shift_jis"
    },
    {
      "index": 20,
      "time": 0,
      "text": "言い伝えが．．．",
